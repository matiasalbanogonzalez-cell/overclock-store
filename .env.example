# ─── Base de datos (PostgreSQL) ──────────────────────────────
# Local:  postgresql://postgres:postgres@localhost:5432/overclock
# Neon (gratis): copiá la "connection string" de tu proyecto
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/overclock"

# URL pública del sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin ───────────────────────────────────────────────────
# Clave para firmar la sesión del panel. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiame-por-una-clave-larga-y-aleatoria"
# Usuario admin que crea el seed
ADMIN_EMAIL="admin@overclock.com"
ADMIN_PASSWORD="Admin123!"

# ─── Pagos ───────────────────────────────────────────────────
# "demo"        → simulador de pago propio (no necesita cuenta de Mercado Pago)
# "mercadopago" → Checkout Pro real (usá credenciales de PRUEBA para el portfolio)
PAYMENTS_MODE="demo"

# Credenciales de Mercado Pago (Tus integraciones → tu aplicación → Credenciales de prueba)
MP_ACCESS_TOKEN=""
# Clave secreta de webhooks (Tus integraciones → Webhooks → "Clave secreta")
MP_WEBHOOK_SECRET=""

# ─── Email (SMTP) ────────────────────────────────────────────
# Si lo dejás vacío, los mails se muestran en la consola del servidor.
# Gmail: smtp.gmail.com / 465 / tu mail / "contraseña de aplicación"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Overclock Store <no-reply@overclock.com>"
# Mail donde avisar de cada venta nueva
STORE_NOTIFY_EMAIL=""
